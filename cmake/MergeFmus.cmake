foreach(variable INPUT_ROOT OUTPUT_ROOT WORK_ROOT)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "${variable} is required")
    endif()
endforeach()

set(platforms linux windows mac-arm mac-intel)
file(GLOB_RECURSE archives RELATIVE "${INPUT_ROOT}/linux" "${INPUT_ROOT}/linux/*.fmu")
list(LENGTH archives archive_count)
if(NOT archive_count EQUAL 28)
    message(FATAL_ERROR "Expected 28 Linux FMUs, found ${archive_count}")
endif()
foreach(platform IN LISTS platforms)
    file(GLOB_RECURSE platform_archives RELATIVE "${INPUT_ROOT}/${platform}" "${INPUT_ROOT}/${platform}/*.fmu")
    list(SORT platform_archives)
    list(SORT archives)
    if(NOT "${platform_archives}" STREQUAL "${archives}")
        message(FATAL_ERROR "FMU catalog differs on ${platform}")
    endif()
endforeach()

foreach(archive IN LISTS archives)
    set(stage "${WORK_ROOT}/${archive}")
    file(REMOVE_RECURSE "${stage}")
    foreach(platform IN LISTS platforms)
        set(extracted "${stage}/${platform}")
        file(MAKE_DIRECTORY "${extracted}")
        file(ARCHIVE_EXTRACT INPUT "${INPUT_ROOT}/${platform}/${archive}" DESTINATION "${extracted}")
        if(NOT EXISTS "${extracted}/modelDescription.xml")
            message(FATAL_ERROR "Missing model description in ${platform}/${archive}")
        endif()
        file(SHA256 "${extracted}/modelDescription.xml" hash)
        if(platform STREQUAL "linux")
            set(expected_hash "${hash}")
        elseif(NOT hash STREQUAL expected_hash)
            message(FATAL_ERROR "Different model descriptions for ${archive}")
        endif()
    endforeach()
    set(result "${stage}/result")
    file(COPY "${stage}/linux/" DESTINATION "${result}")
    if(archive MATCHES "^fmi2/")
        set(binary_dirs "windows|win64" "mac-arm|darwin64")
    else()
        set(binary_dirs "windows|x86_64-windows" "mac-arm|aarch64-darwin" "mac-intel|x86_64-darwin")
    endif()
    foreach(entry IN LISTS binary_dirs)
        string(REPLACE "|" ";" parts "${entry}")
        list(GET parts 0 platform)
        list(GET parts 1 directory)
        if(NOT IS_DIRECTORY "${stage}/${platform}/binaries/${directory}")
            message(FATAL_ERROR "Missing ${directory} for ${archive}")
        endif()
        file(COPY "${stage}/${platform}/binaries/${directory}" DESTINATION "${result}/binaries")
    endforeach()
    get_filename_component(output_directory "${OUTPUT_ROOT}/${archive}" DIRECTORY)
    file(MAKE_DIRECTORY "${output_directory}")
    file(GLOB entries RELATIVE "${result}" "${result}/*")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUTPUT_ROOT}/${archive}" --format=zip ${entries}
        WORKING_DIRECTORY "${result}" RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Failed to create ${archive}")
    endif()
endforeach()